ME="${0##*/}"

print_usage() {
	echo "\
Delete VM and clean all its artifacts

Usage:
	$ME [OPTIONS] VM

Options:
	-y	Confirm purging"
}

# ==============================================================================

unset CONFIRM

while getopts 'y' opt
do
	case "$opt" in
	y ) CONFIRM=y ;;
	* ) exit 1 ;;
	esac
done

shift $(( OPTIND-1 ))

[ $# -gt 0 ] || {
	print_usage >&2
	exit 1
}

DOMAIN="$1"

# ==============================================================================

DOMAIN_STATE='shut off'
CURRENT_STATE="$( LANG=C virsh domstate "$DOMAIN" )" || exit 1

[ "$CURRENT_STATE" = "$DOMAIN_STATE" ] || {
	echo "$ME: $DOMAIN state is $CURRENT_STATE, $DOMAIN_STATE expected" >&2
	exit 1
}

# ==============================================================================

[ -n "$CONFIRM" ] || \
read -p "$ME: Purging $DOMAIN. Confirm [yes/no]: " CONFIRM </dev/tty

case "$CONFIRM" in
[Yy] | [Yy][Ee][Ss] ) ;;
* ) echo "$ME: Cancelled purging $DOMAIN" >&2 ; exit 1 ;;
esac

# ==============================================================================

virsh undefine "$DOMAIN" \
--remove-all-storage \
--snapshots-metadata \
--nvram \
--managed-save

